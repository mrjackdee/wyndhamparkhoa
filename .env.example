# Set secrets directly in Vercel. Never commit real values.
NEXT_PUBLIC_SITE_URL=
DATABASE_URL=
PAYLOAD_SECRET=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional, but required for invitations and account recovery:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Local synthetic testing only. Never set on Vercel:
LOCAL_TEST_MODE=false
TEST_DATABASE_URL=file:./local-test.db
